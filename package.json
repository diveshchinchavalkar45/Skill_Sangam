{
  "name": "skill-sangam",
  "version": "1.0.0",
  "description": "SkillSangam — AI-Powered Skill-Based Team Formation Platform",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server/server.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "seed": "node server/db/seed.js",
    "test": "node --test"
  },
  "keywords": [
    "hackathon",
    "team-matching",
    "skills",
    "ai",
    "team-formation"
  ],
  "author": "SkillSangam Team",
  "license": "MIT",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@google/genai": "^2.24.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  }
}
